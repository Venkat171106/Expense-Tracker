NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/personal_finance_os?schema=public
JWT_ACCESS_SECRET=replace-with-a-secure-random-secret-key-in-production-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-another-secure-secret-key-in-production-min-32-chars
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_FILE_UPLOAD_SIZE_BYTES=5242880
